{
  "id": "cupertino",
  "name": "Cupertino",
  "description": "A native Apple design preset modeled after modern iOS and macOS human interface guidelines. Employs crisp SF Pro typography, refined spacing, and subtle translucent materials for a fluid, familiar Apple environment.",
  "createdAt": "2025-09-08",
  "author": {
    "name": "Alexis C",
    "url": "https://github.com/svnaxis"
  },
  "tags": ["macos", "apple", "minimal", "accessible"],
  "styles": {
    "baseline-style@@accented-interface": true,
    "baseline-style@@color-scheme-light": "cupertino-light",
    "baseline-style@@color-scheme-dark": "cupertino-dark",
    "baseline-style@@font-interface-override": "'SF Pro', 'system-ui'",
    "baseline-style@@layout-style": "layout-baseline",
    "baseline-style@@element-style": "input-cupertino",
    "baseline-style@@status-bar-style": "status-bar-cupertino",
    "baseline-style@@anim-motion-baseline": "cubic-bezier(0.32, 0.72, 0, 1)",
    "baseline-style@@header-height": "52px",
    "baseline-style@@tab-style": "tab-floating-center",
    "baseline-style@@tab-top-left-style": "tab-top-left-icon",
    "baseline-style@@file-header-visibility": "view-header-title-always",
    "baseline-style@@nav-item-active-style": "nav-item-subtle",
    "baseline-style@@font-text-override": "'SF Pro', 'system-ui'",
    "baseline-style@@metadata-style": "metadata-cupertino",
    "baseline-style@@callouts-style": "callouts-tactile",
    "baseline-style@@code-style": "code-tactile",
    "baseline-style@@checkbox-radius": "100px"
  }
}
