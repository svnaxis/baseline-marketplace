{
  "id": "material",
  "name": "Material",
  "description": "Vibrant layers and bold shadows from Google's Material Design.",
  "createdAt": "2026-02-11",
  "author": {
    "name": "Alexis C",
    "url": "https://github.com/svnaxis"
  },
  "tags": ["preset", "vibrant", "modern", "colorful"],
  "styles": {
    "baseline-style@@accented-interface": true,
    "baseline-style@@color-scheme-light": "material-light",
    "baseline-style@@color-scheme-dark": "material-dark",
    "baseline-style@@font-interface-override": "'Google Sans Flex', 'Google Sans Text', 'Google Sans', 'Product Sans'",
    "baseline-style@@element-style": "input-material",
    "baseline-style@@status-bar-style": "status-bar-cupertino",
    "baseline-style@@tab-top-left-style": "tab-top-left-icon",
    "baseline-style@@nav-item-active-style": "nav-item-strong",
    "baseline-style@@colorful-folders": "colorful-folders-off",
    "baseline-style@@font-text-override": "'Google Sans Flex', 'Google Sans Text', 'Google Sans', 'Product Sans'",
    "baseline-style@@h1-size": "2.25rem",
    "baseline-style@@h1-weight": "400",
    "baseline-style@@h2-size": "1.75rem",
    "baseline-style@@h2-weight": " 400",
    "baseline-style@@h3-size": " 1.375rem",
    "baseline-style@@h3-weight": " 400",
    "baseline-style@@h4-weight": " 500",
    "baseline-style@@h5-weight": " 500",
    "baseline-style@@h6-weight": " 500",
    "baseline-style@@callouts-style": "callouts-padded"
  }
}
